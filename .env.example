# Copy this file to `.env` and adjust as needed for local development.
# `.env` is loaded automatically by `npm run dev`/`npm start` (Node's `--env-file-if-exists=.env`).
# Every value below already has a safe default in `src/config.js` if left unset - this file exists to
# make local override explicit, not because any of these are mandatory to boot the service.

# MongoDB connection (defaults match a local MongoDB on the standard port)
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=mmo-cr-catch-recording-service

# Authentication Service - required for any authenticated route to succeed (everything except
# /health and /example). Point this at your local mock Authentication Service.
AUTHENTICATION_SERVICE_URL=http://mmo-cr-authentication-service:3001

# Reference Data Service - required for draft creation, favourite validation, and any other
# reference lookup to succeed. Point this at your local mock Reference Data Service.
REFERENCE_DATA_SERVICE_URL=http://mmo-cr-reference-data-service:3001
# Service-to-service credential presented to the Reference Data Service (never the inbound caller
# token). Replace with your local mock's expected value - never a real credential.
REFERENCE_DATA_SERVICE_TOKEN=local-dev-service-token

# S3-compatible bucket for immutable submission artifacts (JSON snapshots and PDF receipts).
# No default bucket name exists in src/config.js - this name matches the one already used by
# compose.yml for the bundled floci (local S3-compatible) emulator.
CATCH_ARTIFACTS_BUCKET=mmo-cr-catch-recording-artifacts
