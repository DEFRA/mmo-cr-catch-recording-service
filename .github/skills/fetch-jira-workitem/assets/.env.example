# Copy this file to `.env` in the skill root and fill in real values.
# NEVER commit `.env`. The AI agent must never read `.env`; if credentials look
# wrong it must ask you to check this file.

# Your Jira Cloud site base URL.
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian API token (Basic auth). Create one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Prefer a low-privilege account with only "Browse projects" on the relevant projects.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional traversal caps (defaults shown).
JIRA_MAX_DEPTH=5
JIRA_MAX_ISSUES=100

# Optional issue-type policy (comma-separated, case-insensitive; defaults shown).
# Leaf types are collected but never expanded; container types are traversed
# through to reach leaves. Any other type (e.g. Task, Sub-task) is excluded.
JIRA_LEAF_TICKET_TYPES=story,spike,bug
JIRA_CONTAINER_TICKET_TYPES=epic,initiative

# Optional comma-separated host allowlist for classifying design URLs
# (extract-only; these are never fetched). Default: figma.com
JIRA_DESIGN_HOST_ALLOWLIST=figma.com
