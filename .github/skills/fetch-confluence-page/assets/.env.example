# Copy this file to `.env` in the skill root and fill in real values.
# NEVER commit `.env`. The AI agent must never read `.env`; if credentials look
# wrong it must ask you to check this file.

# Your Confluence Cloud site base URL. Either form is accepted:
#   https://your-domain.atlassian.net
#   https://your-domain.atlassian.net/wiki
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki

# Atlassian API token (Basic auth) — the SAME token type as Jira.
# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
# Prefer a low-privilege account with only read access to the relevant spaces.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Optional cap on attachment descriptors collected for one page (default 200).
CONFLUENCE_MAX_ATTACHMENTS=200
