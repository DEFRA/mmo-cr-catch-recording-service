# Copy this file to `.env` and adjust as needed for local development.
# `.env` is loaded automatically by `npm run dev`/`npm start` (Node's `--env-file-if-exists=.env`).
# Every value below already has a safe default in `src/config.js` if left unset - this file exists to
# make local override explicit, not because any of these are mandatory to boot the service.

# MongoDB connection (defaults match a local MongoDB on the standard port)
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=mmo-cr-catch-recording-service

# Reference Data Service - required for draft creation, favourite validation, and any other
# reference lookup to succeed. Point this at your local mock Reference Data Service.
REFERENCE_DATA_SERVICE_URL=http://mmo-cr-reference-data-service:3001
# Service-to-service credential presented to the Reference Data Service (never the inbound caller
# token). Replace with your local mock's expected value - never a real credential.
REFERENCE_DATA_SERVICE_TOKEN=local-dev-service-token

# S3-compatible bucket for immutable submission artifacts (JSON snapshots and PDF receipts).
# No default bucket name exists in src/config.js - this name matches the one already used by
# compose.yml for the bundled floci (local S3-compatible) emulator.
CATCH_ARTIFACTS_BUCKET=mmo-cr-catch-recording-artifacts

# Microsoft Entra External ID access-token authentication and User Profile Service authorization
# (every protected route requires a valid Entra access token). All values below are
# ILLUSTRATIVE placeholders, never real tenant, application or service values. Leave the whole group
# unset for local development; if any trust-boundary value is set, all of them must be set and valid.
# Outside local development (ENVIRONMENT other than `local`, or NODE_ENV=production) the full group is
# mandatory and the service refuses to start without it. See docs/configuration-decisions.md.
# ENTRA_ISSUER=https://login.entra.example.invalid/<tenant>/v2.0
# ENTRA_AUDIENCE=api://<catch-recording-api>
# ENTRA_OIDC_METADATA_URL=https://login.entra.example.invalid/<tenant>/v2.0/.well-known/openid-configuration
# ENTRA_ALLOWED_ALGORITHMS=RS256
# ENTRA_USER_ID_CLAIM=oid
# ENTRA_METADATA_REFRESH_INTERVAL_SECONDS=3600
# ENTRA_MINIMUM_REFRESH_INTERVAL_SECONDS=60
# ENTRA_REQUEST_TIMEOUT_MS=2000
# AUTHORIZATION_SERVICE_ID=catch-recording
# AUTHORIZATION_USER_ROLES_URL_TEMPLATE=https://user-profile.example.invalid/users/{entraObjectId}/roles
# AUTHORIZATION_ROLE_DEFINITIONS_URL=https://user-profile.example.invalid/roles-definitions/services/catch-recording
# AUTHORIZATION_USER_ROLE_CACHE_TTL_SECONDS=300
# AUTHORIZATION_USER_ROLE_CACHE_MAXIMUM_ENTRIES=1000
# AUTHORIZATION_ROLE_DEFINITIONS_CACHE_TTL_SECONDS=300
# AUTHORIZATION_ROLE_DEFINITIONS_CACHE_MAXIMUM_STALE_SECONDS=900
# USER_PROFILE_SERVICE_TIMEOUT_MS=2000
# USER_PROFILE_SERVICE_RETRY_COUNT=1
# USER_PROFILE_SERVICE_RETRY_DELAY_MS=100
